# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/pramaan

# Secret used to sign JWT tokens - change this in production
JWT_SECRET=pramaan_dev_secret_change_me

# Port the API server runs on
PORT=5000

# Optional: if you set a real Gemini key, the AI service will try to use it.
# If left empty, PRAMAAN automatically runs in Demo AI Mode (deterministic, no key needed).
GEMINI_API_KEY=
